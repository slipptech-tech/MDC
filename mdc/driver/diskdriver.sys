NTSTATUS 玄天_初始化驅動程序()
{
    DEVICE_OBJECT* 蒼龍 = nullptr;
    DRIVER_OBJECT* 玄武 = nullptr;

    玄武->DriverStart = 0xFFFFF8027A910000;
    玄武->DriverSize = 0x0002A000;
    玄武->DriverSection = 0x0000000000000000;

    龍影::初始化磁碟控制器();
    龍影::建立裝置接口();
    龍影::註冊驅動程序();

    return STATUS_SUCCESS;
}

